# Environment template. Copy to .env for local development; deployed
# environments read everything from Google Secret Manager — never from a
# committed file. No value here is a real credential.

# --- Shared ---
ENVIRONMENT=local                # local | dev | staging | production
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_RELEASE=

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=                    # pooled connection string (runtime)
DATABASE_DIRECT_URL=             # direct connection string (migrations)

# --- Cache & queue (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Authentication (Clerk) ---
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Telephony (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=

# --- Speech & language ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CARTESIA_API_KEY=

# --- Calendar (Google) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Service-to-service ---
API_BASE_URL=http://localhost:8000
VOICE_WS_BASE_URL=ws://localhost:8001
WORKER_BASE_URL=http://localhost:8002
CALL_TOKEN_SIGNING_KEY=
INTERNAL_SERVICE_TOKEN=

# --- Application-layer encryption (base64 32-byte keys) ---
DATA_ENCRYPTION_KEY=
LOOKUP_HASH_KEY=
DASHBOARD_BASE_URL=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
